# URL absoluta del endpoint de productos. Se usa tal cual, sin agregarle rutas.
VITE_API_URL=https://srkiosco-api-beta.azurewebsites.net/SrKioscoRemote/GetProducts?KioskID=8

# JWT fijo que entrega el reto. Se envia como "Authorization: Bearer <token>".
# AVISO: toda variable VITE_* queda incluida en el bundle publico del navegador.
# Usar solo con tokens de entornos no productivos.
VITE_API_TOKEN=
